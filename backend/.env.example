DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/adaptive_bi
JWT_SECRET=your_jwt_secret_here
# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_EXPIRE_HOURS=24

# External DWDM toolchain (KNIME) — update these once KNIME is installed and the
# adaptive-bi-pipeline workflow exists. Until then, /upload/dataset will fail
# gracefully with a clear "KNIME executable not found" error.
KNIME_EXECUTABLE=C:/Program Files/KNIME/knime.exe
KNIME_WORKSPACE=C:/knime-workspace/adaptive-bi-pipeline
KNIME_INPUT_FOLDER=C:/adaptive-bi/knime-input
KNIME_OUTPUT_FOLDER=C:/adaptive-bi/knime-output
KNIME_TIMEOUT_SECONDS=1800
GEMINI_API_KEY=your_gemini_api_key_here
